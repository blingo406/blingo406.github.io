---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] =>
		Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

	if (
		typeof srcConfig === "object" &&
		srcConfig !== null &&
		!Array.isArray(srcConfig)
	) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) {
	return null;
}

// 轮播配置
const isCarouselEnabled =
	config.carousel?.enable &&
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top":
			return "object-top";
		case "bottom":
			return "object-bottom";
		default:
			return "object-center";
	}
})();
---
<div
  class:list={["fixed inset-0 w-full h-full overflow-hidden pointer-events-none wallpaper-container", className]}
  style={`display: none; z-index: ${zIndex}; opacity: var(--wallpaper-opacity, ${opacity}); filter: blur(var(--wallpaper-blur, ${blurAmount}px));`}
  data-fullscreen-wallpaper
  data-desktop={JSON.stringify(imageSources.desktop)}
  data-mobile={JSON.stringify(imageSources.mobile)}
  data-carousel={isCarouselEnabled ? "true" : "false"}
  data-interval={carouselInterval}
  data-default-mode={siteConfig.wallpaperMode.defaultMode}
  data-switches={JSON.stringify(config.overlay?.switchable ?? true)}
>
  <img alt="" class={`absolute inset-0 w-full h-full object-cover ${positionClass}`} decoding="async" data-wallpaper-image />
</div>
<script is:inline>
(() => {
  window.__wallpaper_cleanup?.();
  const container = document.querySelector('[data-fullscreen-wallpaper]');
  if (!container) return;
  const image = container.querySelector('[data-wallpaper-image]');
  const media = matchMedia('(min-width: 768px)');
  const desktop = JSON.parse(container.dataset.desktop);
  const mobile = JSON.parse(container.dataset.mobile);
  let timer = null;
  let index = 0;
  let disposed = false;
  let pending = null;
  try { index = Math.max(0, Number(sessionStorage.getItem('mizuki_wallpaper_index')) || 0); } catch {}
  function mode() {
    try { return localStorage.getItem('wallpaperMode') || container.dataset.defaultMode; }
    catch { return container.dataset.defaultMode; }
  }
  function images() { return media.matches ? desktop : mobile; }
  function show() {
    const list = images();
    if (!list.length || mode() !== 'overlay' || document.hidden) return;
    const source = list[index % list.length];
    if (image.getAttribute('src') === source || pending === source) return;
    pending = source;
    const next = new Image();
    next.onload = () => {
      if (!disposed && mode() === 'overlay' && images()[index % images().length] === source) image.src = source;
      if (pending === source) pending = null;
    };
    next.onerror = () => { if (pending === source) pending = null; };
    next.src = source;
  }
  function stop() { if (timer) clearInterval(timer); timer = null; }
  function update() {
    stop();
    const active = mode() === 'overlay';
    container.style.display = active ? '' : 'none';
    if (!active || document.hidden) return;
    // Restore saved overlay controls before the settings component hydrates.
    try {
      const value = JSON.parse(container.dataset.switches);
      const switches = typeof value === 'object' ? value : { opacity: value, blur: value, cardOpacity: value };
      for (const [key, property, suffix] of [['opacity', '--wallpaper-opacity', ''], ['blur', '--wallpaper-blur', 'px']]) {
        const saved = localStorage.getItem(key === 'opacity' ? 'overlayOpacity' : 'overlayBlur');
        if (switches[key] && saved !== null) container.style.setProperty(property, saved + suffix);
      }
      const card = localStorage.getItem('overlayCardOpacity');
      if (switches.cardOpacity && card !== null) document.documentElement.style.setProperty('--card-transparent-opacity', card);
    } catch {}
    show();
    if (container.dataset.carousel === 'true' && images().length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = setInterval(() => {
        if (!container.isConnected) { window.__wallpaper_cleanup?.(); return; }
        index = (index + 1) % images().length;
        try { sessionStorage.setItem('mizuki_wallpaper_index', String(index)); } catch {}
        show();
      }, Number(container.dataset.interval) * 1000);
    }
  }
  media.addEventListener('change', update);
  window.addEventListener('wallpaper-mode-change', update);
  document.addEventListener('visibilitychange', update);
  window.__wallpaper_cleanup = () => {
    disposed = true;
    stop();
    media.removeEventListener('change', update);
    window.removeEventListener('wallpaper-mode-change', update);
    document.removeEventListener('visibilitychange', update);
  };
  update();
})();
</script>
