---
import { Icon } from "astro-icon/components";

import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getPostCategoryPath } from "@/utils/category-utils";
import { getCategoryPathUrl, getCategoryUrl } from "@/utils/url-utils";

interface Props {
	category?: string;
	parentCategory?: string;
	categoryPath?: string[];
	class?: string;
}

const { category, parentCategory, categoryPath, class: className } = Astro.props;
const path = getPostCategoryPath({ category, parentCategory, categoryPath });
---

<div class:list={["flex items-center", className]}>
	<div class="meta-icon">
		<Icon name="material-symbols:book-2-outline-rounded" class="text-xl" />
	</div>
	<div class="flex flex-row flex-wrap items-center gap-y-1">
		{path.length ? path.map((name, index) => (
			<>
				{index > 0 && <span class="text-50 text-sm mx-1 opacity-50">›</span>}
				<a href={getCategoryPathUrl(path.slice(0, index + 1))}
					class="link-lg transition text-50 text-sm font-medium hover:text-(--primary) whitespace-nowrap">{name}</a>
			</>
		)) : <a href={getCategoryUrl("")} class="link-lg text-50 text-sm">{i18n(I18nKey.uncategorized)}</a>}
	</div>
</div>
