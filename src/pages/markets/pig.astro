---
import PriceChart from "../../components/markets/PriceChart.astro";
import MarketLayout from "../../layouts/MarketLayout.astro";
import {
	delta,
	metrics,
	series,
	snapshot,
	sources,
	statusFor,
} from "../../lib/markets";

const status = statusFor("moa_weekly");
const historyYears = Array.from(
	{ length: new Date(snapshot.generatedAt).getUTCFullYear() - 2013 },
	(_, i) => String(2014 + i),
);
const extras = sources.filter(
	(s) => s.section === "pig" && s.id !== "moa_weekly_prices",
);
---
<MarketLayout title="猪产业链" active="pig" description="全国外三元现货均价、官方周价与饲料成本，按各自统计口径持续更新。">
  {status?.state !== "ok" && <p class="notice">价格来源：{status?.message || "尚未接入"}</p>}
  {["zhuwang_daily", "nbs_prices"].filter((id) => statusFor(id)?.state !== "ok").map((id) => <p class="notice">{id === "zhuwang_daily" ? "外三元日价" : "外三元旬价"}：{statusFor(id)?.message || "尚未成功采集"}</p>)}
  <div class="metric-grid">{["hog_spot", "hog", "piglet", "corn"].map((key) => {
    const rows = series(key), last = rows.at(-1);
    return <article class="metric"><h2 class="metric-label">{metrics[key].name}</h2><p class="metric-value">{last?.value.toFixed(2) || "—"}<small>{metrics[key].unit}</small></p><p class="metric-change">{delta(rows)}</p><p class="metric-date">采集 {last?.date || "—"} · {metrics[key].frequency || "周度"}</p></article>;
  })}</div>
  <PriceChart id="spot-chart" title="全国外三元生猪现货均价" metricIds={["hog_spot", "hog_nbs"]} />
  <p class="notice">历史尚未补齐：农业农村部周价在 2014 年仅有部分旧档，2015—2016 年及 2017 年上半年仍有缺口。外三元日价自本站接入起累积，旬价当前从 2021 年开始。完整程度见下方逐年期数。</p>
  <div class="chart-grid"><PriceChart id="hog-chart" title="养殖端价格" metricIds={["hog", "piglet", "pork"]} /><PriceChart id="feed-chart" title="饲料与成本" metricIds={["corn", "soymeal", "feed"]} /></div>
  <section class="panel"><h2>历史覆盖与更新规则</h2><p class="source-line">目标回溯至 2014 年，默认展示全部已取得的历史，随后只追加，不滚动删除。切换「近 12 年」仅改变视图。当前各指标的实际起止日期如下；缺期保留空白，尚未取得的历史不作估算。</p><div class="table-wrap"><table><thead><tr><th>指标</th><th>已收录范围</th><th>期数</th></tr></thead><tbody>{["hog_spot", "hog_nbs", "hog", "piglet", "pork", "corn", "soymeal", "feed"].map((key) => { const rows = series(key); return <tr><td>{metrics[key].name}</td><td>{rows.at(0)?.date || "—"} 至 {rows.at(-1)?.date || "—"}</td><td>{rows.length}</td></tr>; })}</tbody></table></div><p class="source-line">日度报价为中国养猪网／玄田数据公开全国报价；旬度为国家统计局流通领域市场价格；周度为农业农村部集贸市场调查。长期调查样本范围有调整，应结合原文比较。更正前的数值保留在数据归档中，目前共 {snapshot.revisions.length} 条修订记录。</p></section>
  <section class="panel"><details><summary>逐年覆盖期数（0 表示该年尚无数据）</summary><div class="table-wrap"><table><thead><tr><th>年份</th><th>生猪周价</th><th>外三元旬价</th><th>外三元日价</th></tr></thead><tbody>{historyYears.map((year) => <tr><td>{year}</td>{["hog", "hog_nbs", "hog_spot"].map((key) => <td>{series(key).filter((r) => r.date.startsWith(year)).length}</td>)}</tr>)}</tbody></table></div></details><a class="text-link" href="/markets/archive.json" download>下载完整公开数据及历史修订（JSON）</a></section>
  <div class="section-intro"><h2>沿产业链继续查</h2><a class="text-link" href="/markets/sources/">全部来源 →</a></div>
  <div class="source-grid">{extras.map((source) => <article class="source-card"><span class={`badge ${source.collector ? "" : "pending"}`}>{source.collector ? "自动更新" : "来源入口"}</span><h3><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} ↗</a></h3><p>{source.coverage.join(" · ")}</p><div class="source-meta"><span>{source.provider}</span><span>{source.frequency}</span></div></article>)}</div>
</MarketLayout>
