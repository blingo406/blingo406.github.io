---
import source from "../../../public/data/gold-etf/state.json";
import calendar from "../../data/gold-etf/calendar.json";
import ObservationLayout from "../../layouts/ObservationLayout.astro";
import "../../styles/gold-etf.css";

const seed = { quote: source.quote, navs: source.navs };
---
<ObservationLayout title="指标检测" description="工银黄金股 ETF 159315 折溢价提醒：09:16、09:21 关注参考折价达到 5% 的情况。" active="strategies" class="strategy-app">
	<div class="market-shell strategy-shell">
		<section class="etf-hero" id="etf-hero" data-level="0" aria-labelledby="etf-name">
			<h1 id="etf-name">黄金股ETF套利</h1>
			<button type="button" class="etf-status" id="etf-enable" aria-label="开启黄金股ETF套利的声音与桌面提醒" title="点击开启提醒：09:16、09:21，参考折价达到5%，排除跌停价。请保持页面打开。">
				<span class="etf-status-dot" aria-hidden="true"></span><span id="etf-signal" role="status" aria-live="polite">读取中</span>
			</button>
			<p class="sr-only" id="etf-notify-state" role="status">点击状态框开启声音与桌面提醒。</p>
		</section>
		<noscript><p class="notice">开启 JavaScript 以显示折溢价提醒。</p></noscript>
	</div>
	<script is:inline id="etf-seed" type="application/json" set:html={JSON.stringify({ seed, calendar }).replace(/</g, "\\u003c")} />
	<script>import "../../lib/gold-etf-client";</script>
</ObservationLayout>
